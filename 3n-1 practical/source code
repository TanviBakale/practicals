# Program 1: The 3n + 1 Problem

## C Program

```c
#include <stdio.h>

int cycleLength(long long n)
{
    int count = 1;

    while(n != 1)
    {
        if(n % 2 == 0)
            n = n / 2;
        else
            n = 3 * n + 1;

        count++;
    }

    return count;
}

int main()
{
    int i, j;

    while(scanf("%d %d", &i, &j) == 2)
    {
        int start = i;
        int end = j;

        if(start > end)
        {
            int temp = start;
            start = end;
            end = temp;
        }

        int maxCycle = 0;

        for(int k = start; k <= end; k++)
        {
            int len = cycleLength(k);

            if(len > maxCycle)
                maxCycle = len;
        }

        printf("%d %d %d\n", i, j, maxCycle);
    }

    return 0;
}
```

