Program 1: Jolly Jumpers (UVa 10038)
Theory

A sequence of n numbers is called Jolly Jumper if the absolute differences between successive elements take all values from 1 to n−1 exactly once.

Example:

1 4 2 3

Differences:

3 2 1

Since all values from 1 to 3 are present, the sequence is Jolly.

C Program
#include <stdio.h>
#include <stdlib.h>

int main()
{
    int n;

    while(scanf("%d",&n)==1)
    {
        int a[3005];
        int diff[3005]={0};

        for(int i=0;i<n;i++)
            scanf("%d",&a[i]);

        for(int i=1;i<n;i++)
        {
            int d=abs(a[i]-a[i-1]);

            if(d>=1 && d<n)
                diff[d]=1;
        }

        int jolly=1;

        for(int i=1;i<n;i++)
        {
            if(diff[i]==0)
            {
                jolly=0;
                break;
            }
        }

        if(jolly)
            printf("Jolly\n");
        else
            printf("Not jolly\n");
    }

    return 0;
}

/*

Sample Input

4 1 4 2 3
5 1 4 2 -1 6

Sample Output

Jolly
Not jolly

*/
