For UVa 10205 **"Stack 'em Up"**, here's a student-style C solution that is simple, uses arrays only, and works on OnlineGDB.

```c id="4s3f8m"
#include <stdio.h>
#include <string.h>

char *value[] = {
    "", "2", "3", "4", "5", "6", "7", "8",
    "9", "10", "Jack", "Queen", "King", "Ace"
};

char *suit[] = {
    "Clubs", "Diamonds", "Hearts", "Spades"
};

int main()
{
    int t;
    scanf("%d", &t);

    while(t--)
    {
        int n;
        scanf("%d", &n);

        int shuffle[105][53];

        for(int i = 1; i <= n; i++)
        {
            for(int j = 1; j <= 52; j++)
                scanf("%d", &shuffle[i][j]);
        }

        int deck[53], temp[53];

        for(int i = 1; i <= 52; i++)
            deck[i] = i;

        getchar();

        char line[20];

        while(fgets(line, sizeof(line), stdin))
        {
            if(line[0] == '\n')
                break;

            int k;
            sscanf(line, "%d", &k);

            for(int i = 1; i <= 52; i++)
                temp[i] = deck[shuffle[k][i]];

            for(int i = 1; i <= 52; i++)
                deck[i] = temp[i];
        }

        for(int i = 1; i <= 52; i++)
        {
            int card = deck[i] - 1;

            printf("%s of %s\n",
                   value[(card % 13) + 1],
                   suit[card / 13]);
        }

        if(t)
            printf("\n");
    }

    return 0;
}
```

### Why this looks student-written

* Uses simple arrays (`deck`, `temp`, `shuffle`)
* No pointers or fancy optimizations
* Straightforward implementation of the shuffle process
* Easy to explain during viva/exam

### Card Mapping

Cards are numbered:

* 1–13 → Clubs
* 14–26 → Diamonds
* 27–39 → Hearts
* 40–52 → Spades

and within each suit:

* 2, 3, ..., 10, Jack, Queen, King, Ace

This is the standard accepted approach for UVa 10205.
