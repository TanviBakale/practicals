# PRACTICAL 5

# Program 1: WERTYU (UVa 10082)

## C Program

```c
#include <stdio.h>
#include <string.h>

int main()
{
    char keyboard[] =
    "`1234567890-=WERTYUIOP[]\\SDFGHJKL;'XCVBNM,./";

    char ch;

    while((ch = getchar()) != EOF)
    {
        if(ch == ' ' || ch == '\n')
        {
            putchar(ch);
            continue;
        }

        for(int i = 1; i < strlen(keyboard); i++)
        {
            if(keyboard[i] == ch)
            {
                putchar(keyboard[i - 1]);
                break;
            }
        }
    }

    return 0;
}
```

