# Practical 2: Introduction to Online Judge
For UVa 706 "LCD Display", here's a simple student-style C solution that works on OnlineGDB.

#include <stdio.h>
#include <string.h>

int main()
{
    int s;
    char num[20];

    while (scanf("%d %s", &s, num))
    {
        if (s == 0 && strcmp(num, "0") == 0)
            break;

        int len = strlen(num);

        /* Top */
        for (int i = 0; i < len; i++)
        {
            printf(" ");
            if (num[i] != '1' && num[i] != '4')
                for (int j = 0; j < s; j++) printf("-");
            else
                for (int j = 0; j < s; j++) printf(" ");

            printf(" ");
            if (i != len - 1) printf(" ");
        }
        printf("\n");

        /* Upper part */
        for (int r = 0; r < s; r++)
        {
            for (int i = 0; i < len; i++)
            {
                if (num[i]=='0'||num[i]=='4'||num[i]=='8'||num[i]=='9')
                    printf("|");
                else
                    printf(" ");

                for (int j = 0; j < s; j++) printf(" ");

                if (num[i]!='5' && num[i]!='6')
                    printf("|");
                else
                    printf(" ");

                if (i != len - 1) printf(" ");
            }
            printf("\n");
        }

        /* Middle */
        for (int i = 0; i < len; i++)
        {
            printf(" ");

            if (num[i]!='0' && num[i]!='1' && num[i]!='7')
                for (int j = 0; j < s; j++) printf("-");
            else
                for (int j = 0; j < s; j++) printf(" ");

            printf(" ");
            if (i != len - 1) printf(" ");
        }
        printf("\n");

        /* Lower part */
        for (int r = 0; r < s; r++)
        {
            for (int i = 0; i < len; i++)
            {
                if (num[i]=='0'||num[i]=='2'||num[i]=='6'||num[i]=='8')
                    printf("|");
                else
                    printf(" ");

                for (int j = 0; j < s; j++) printf(" ");

                if (num[i]!='2')
                    printf("|");
                else
                    printf(" ");

                if (i != len - 1) printf(" ");
            }
            printf("\n");
        }

        /* Bottom */
        for (int i = 0; i < len; i++)
        {
            printf(" ");

            if (num[i]!='1' && num[i]!='4' && num[i]!='7')
                for (int j = 0; j < s; j++) printf("-");
            else
                for (int j = 0; j < s; j++) printf(" ");

            printf(" ");
            if (i != len - 1) printf(" ");
        }
        printf("\n\n");
    }

    return 0;
}

