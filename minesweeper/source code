# Program 2: Minesweeper

## C Program

```c
#include <stdio.h>

int main()
{
    int n, m;
    int field = 1;

    while (1)
    {
        scanf("%d %d", &n, &m);

        if (n == 0 && m == 0)
            break;

        char a[105][105];
        int ans[105][105] = {0};

        for (int i = 0; i < n; i++)
            scanf("%s", a[i]);

        for (int i = 0; i < n; i++)
        {
            for (int j = 0; j < m; j++)
            {
                if (a[i][j] == '*')
                {
                    ans[i][j] = -1;

                    for (int x = i - 1; x <= i + 1; x++)
                    {
                        for (int y = j - 1; y <= j + 1; y++)
                        {
                            if (x >= 0 && x < n && y >= 0 && y < m)
                            {
                                if (ans[x][y] != -1)
                                    ans[x][y]++;
                            }
                        }
                    }
                }
            }
        }

        if (field > 1)
            printf("\n");

        printf("Field #%d:\n", field++);

        for (int i = 0; i < n; i++)
        {
            for (int j = 0; j < m; j++)
            {
                if (ans[i][j] == -1)
                    printf("*");
                else
                    printf("%d", ans[i][j]);
            }
            printf("\n");
        }
    }

    return 0;
}
```

