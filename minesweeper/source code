# Practical 1: Program 2 – Minesweeper

## Program Code

```cpp
#include <iostream>
#include <vector>
#include <string>

using namespace std;

int countMines(const vector<string>& minefield, int i, int j)
{
    int count = 0;

    for (int di = -1; di <= 1; di++)
    {
        for (int dj = -1; dj <= 1; dj++)
        {
            int ni = i + di;
            int nj = j + dj;

            if (ni >= 0 &&
                ni < minefield.size() &&
                nj >= 0 &&
                nj < minefield[0].size() &&
                minefield[ni][nj] == '*')
            {
                count++;
            }
        }
    }

    return count;
}

int main()
{
    int fieldCount = 1;

    while (true)
    {
        int rows, columns;

        cin >> rows >> columns;

        if (rows == 0 && columns == 0)
        {
            break;
        }

        if (fieldCount > 1)
        {
            cout << endl;
        }

        vector<string> minefield(rows);

        for (int i = 0; i < rows; i++)
        {
            cin >> minefield[i];
        }

        cout << "Field #" << fieldCount << ":" << endl;

        for (int i = 0; i < rows; i++)
        {
            for (int j = 0; j < columns; j++)
            {
                if (minefield[i][j] == '*')
                {
                    cout << '*';
                }
                else
                {
                    int count = countMines(minefield, i, j);
                    cout << count;
                }
            }

            cout << endl;
        }

        fieldCount++;
    }

    return 0;
}
```

